{
  "schemaVersion": 1,
  "bundleID": "cn.mendao.launcher",
  "appVersion": "1.20",
  "actions": [
    {
      "action": "portal.openSite",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "siteID": {
            "type": "string"
          },
          "browserID": {
            "type": "string"
          }
        },
        "required": [
          "siteID"
        ],
        "additionalProperties": false
      },
      "supportsItems": false,
      "supportsReferences": false,
      "requiresUserConfirmation": true
    },
    {
      "action": "portal.openWorkspace",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "workspaceID": {
            "type": "string"
          }
        },
        "required": [
          "workspaceID"
        ],
        "additionalProperties": false
      },
      "supportsItems": false,
      "supportsReferences": false,
      "requiresUserConfirmation": true
    },
    {
      "action": "portal.focusSearch",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "supportsItems": false,
      "supportsReferences": false,
      "requiresUserConfirmation": true
    },
    {
      "action": "portal.proposeSite",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "supportsItems": false,
      "supportsReferences": false,
      "requiresUserConfirmation": true
    },
    {
      "action": "portal.prepareDownload",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "required": [
          "urls"
        ],
        "additionalProperties": false
      },
      "supportsItems": false,
      "supportsReferences": false,
      "requiresUserConfirmation": true
    },
    {
      "action": "downloads.prepare",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "file"
            ]
          }
        },
        "required": [
          "urls"
        ],
        "additionalProperties": false
      },
      "supportsItems": false,
      "supportsReferences": false,
      "requiresUserConfirmation": true
    }
  ],
  "windowsTransport": {
    "argument": "--gaoaction",
    "resultActions": [
      "downloads.prepare"
    ]
  }
}
