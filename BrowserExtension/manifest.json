{
  "manifest_version": 3,
  "name": "搞门户助手",
  "version": "1.13.0",
  "description": "从浏览器收藏网页到搞门户，并为从搞门户启动的网站填入所选账号。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "搞门户助手"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
